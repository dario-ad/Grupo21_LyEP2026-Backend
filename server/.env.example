# Copiar este archivo como server/.env y completar los valores.
# server/.env NUNCA debe subirse al repositorio (ya está en el .gitignore).

# Cadena de conexión de MongoDB Atlas
MONGODB_URI=

# Clave para firmar los tokens. Debe ser larga y aleatoria
JWT_SECRET=
# Duración del token (opcional, por defecto 8h)
JWT_EXPIRES_IN=8h

# Cuentas de prueba que crea el script de inicialización.
# La contraseña debe tener al menos 8 caracteres, una mayúscula y un número
# (son las reglas del formulario de login).
SEED_GERENCIA_NOMBRE=
SEED_GERENCIA_EMAIL=
SEED_GERENCIA_PASSWORD=

SEED_SOPORTE_NOMBRE=
SEED_SOPORTE_EMAIL=
SEED_SOPORTE_PASSWORD=